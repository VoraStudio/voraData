{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "dgx-spark": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://voradata-ia.hopto.org:30000/v1",
        "apiKey": "{env:AI_API_KEY}"
      },
      "models": {
        "qwen38-27b": {
          "name": "Qwen 3.8 27B (Visión & Multimodal)",
          "limit": {
            "context": 65536,
            "output": 2000
          },
          "options": {
            "extraBody": {
              "chat_template_kwargs": { "enable_thinking": false }
            }
          }
        }
      }
    }
  },
  "mcp": {
    "flowbite": {
      "type": "local",
      "command": ["npx", "-y", "flowbite-mcp"],
      "enabled": true
    },
    "preline": {
      "type": "local",
      "command": ["npx", "-y", "htmlstreamofficial/preline"],
      "enabled": true
    }
  }
}
